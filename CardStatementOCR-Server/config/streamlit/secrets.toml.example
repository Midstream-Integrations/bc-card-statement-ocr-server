# Copy to config/streamlit/secrets.toml (chmod 600). Microsoft 365 sign-in for the portal.
[auth]
redirect_uri = "https://YOUR-HOST/oauth2callback"
cookie_secret = "run: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'"

[auth.microsoft]
client_id = "ENTRA-APP-CLIENT-ID"
client_secret = "ENTRA-APP-CLIENT-SECRET"
# single-tenant: only company accounts can sign in
server_metadata_url = "https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0/.well-known/openid-configuration"
client_kwargs = { scope = "openid profile email" }
