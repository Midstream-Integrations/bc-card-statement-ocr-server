# config/ocr.env  (chmod 600) - read by both services and loaded automatically by core/settings.py
# Copy this file to config/ocr.env and fill it in. See docs/INSTALL.md.
# Comments go on their own line. systemd's EnvironmentFile doesn't strip comments after a value.

# ---- server
OCR_DATA_DIR=/var/lib/ocr
# what goes in emailed links (include :port if not 443)
OCR_PUBLIC_URL=https://ocr.example.com
OCR_API_KEY=generate-with-python3-c-import-secrets-print-secrets.token_urlsafe-32
# comma-separated; admins also see Statement breakdown
OCR_ADMINS=you@example.com
# time zone shown in Requisition Form signatures
OCR_TIMEZONE=America/Chicago
# days a receipt date may differ from the charge date
OCR_RECEIPT_DATE_WINDOW=3
# read each receipt and check it against the charge (needs a faster server); false = just attach it
OCR_READ_RECEIPTS=false
# seconds to spend reading a receipt before giving up (the user then explains it or retakes it)
OCR_TIMEOUT_SECONDS=5

# ---- Business Central (Entra app with API.ReadWrite.All, registered in BC with MID OCR USER)
BC_TENANT_ID=YOUR-TENANT-ID
BC_ENVIRONMENT=Production
BC_CLIENT_ID=ENTRA-APP-CLIENT-ID
BC_CLIENT_SECRET=ENTRA-APP-CLIENT-SECRET
# General Ledger Setup -> Shortcut Dimension 1 / 2 Code
BC_DIM1_CODE=DEPARTMENT
BC_DIM2_CODE=PROJECT
# Company SystemId used by the 2nd-approver sweep (reqapproval/secondary.py)
REQAPPROVAL_COMPANY_ID=YOUR-COMPANY-ID

# ---- email (requisition-approval emails are sent by this server)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=approvals@example.com
SMTP_PASS=MAILBOX-PASSWORD
# optional: shown in the email footer
OCR_AP_EMAIL=ap@example.com
# optional: shown in the email footer
OCR_IT_EMAIL=it@example.com

# ---- optional
# Source code link in the portal (AGPL-3.0). Change it if you run a modified copy.
# OCR_SOURCE_URL=https://github.com/Midstream-Integrations/bc-card-statement-ocr-server
# Delegates: delegate=person they act for=that person's name, entries separated by ';'
# OCR_DELEGATES=jdoe@example.com=jsmith@example.com=J. Smith
# Local testing only - skips Microsoft 365 sign-in. NEVER set on a server.
# OCR_DEV_USER=you@example.com
